# SecureVault — Environment Variable Template
# Classification: INTERNAL — Never commit actual values to version control
# Copy this file to .env and fill in values before running the application
# See docs/security/env-setup.md for detailed instructions

# ─────────────────────────────────────────────
# APPLICATION
# ─────────────────────────────────────────────
APP_ENV=development                          # development | staging | production
APP_NAME=SecureVault
APP_VERSION=5.0.0
APP_URL=https://localhost:3000
API_URL=https://localhost:8000
DEBUG=False                                  # MUST be False in production
SECRET_KEY=REPLACE_WITH_64_CHAR_RANDOM_STRING  # python -c "import secrets; print(secrets.token_urlsafe(64))"
ALLOWED_HOSTS=localhost,127.0.0.1

# ─────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────
DB_ENGINE=django.db.backends.postgresql
DB_NAME=securevault_db
DB_USER=securevault_user
DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
DB_HOST=postgres
DB_PORT=5432
DB_SSL_MODE=require                          # always require in production

# ─────────────────────────────────────────────
# REDIS (SESSION / CACHE / RATE LIMITING)
# ─────────────────────────────────────────────
REDIS_URL=redis://:REPLACE_WITH_REDIS_PASSWORD@redis:6379/0
REDIS_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
CACHE_TTL=300

# ─────────────────────────────────────────────
# JWT CONFIGURATION
# ─────────────────────────────────────────────
JWT_ALGORITHM=RS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# Paths to RSA keys (generated offline, stored in secrets manager)
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private_key
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public_key

# ─────────────────────────────────────────────
# OAUTH2 CONFIGURATION
# ─────────────────────────────────────────────
OAUTH2_CLIENT_ID=REPLACE_WITH_OAUTH_CLIENT_ID
OAUTH2_CLIENT_SECRET=REPLACE_WITH_OAUTH_CLIENT_SECRET
OAUTH2_REDIRECT_URI=https://localhost:8000/api/v1/auth/callback/
GOOGLE_OAUTH_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
GOOGLE_OAUTH_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET

# ─────────────────────────────────────────────
# MFA CONFIGURATION
# ─────────────────────────────────────────────
MFA_TOTP_ISSUER=SecureVault
MFA_TOTP_DIGITS=6
MFA_TOTP_INTERVAL=30
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=SecureVault
WEBAUTHN_ORIGIN=https://localhost:3000

# ─────────────────────────────────────────────
# OBJECT STORAGE (MinIO / AWS S3)
# ─────────────────────────────────────────────
STORAGE_BACKEND=minio                        # minio | s3
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=REPLACE_WITH_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=REPLACE_WITH_MINIO_SECRET_KEY
MINIO_BUCKET=securevault-files
MINIO_SECURE=True
PRESIGNED_URL_EXPIRY=300                     # seconds (5 minutes)
MAX_FILE_SIZE_MB=50

# AWS S3 (if STORAGE_BACKEND=s3)
AWS_ACCESS_KEY_ID=REPLACE_IF_USING_S3
AWS_SECRET_ACCESS_KEY=REPLACE_IF_USING_S3
AWS_STORAGE_BUCKET_NAME=REPLACE_IF_USING_S3
AWS_S3_REGION_NAME=us-east-1

# ─────────────────────────────────────────────
# EMAIL CONFIGURATION
# ─────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.securevault.io
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=noreply@securevault.io
EMAIL_HOST_PASSWORD=REPLACE_WITH_EMAIL_PASSWORD
DEFAULT_FROM_EMAIL=SecureVault <noreply@securevault.io>

# ─────────────────────────────────────────────
# CLAMAV ANTIVIRUS
# ─────────────────────────────────────────────
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=30

# ─────────────────────────────────────────────
# SECRETS MANAGER (HashiCorp Vault or AWS KMS)
# ─────────────────────────────────────────────
SECRETS_BACKEND=vault                        # vault | aws_kms
VAULT_ADDR=https://vault:8200
VAULT_TOKEN=REPLACE_WITH_VAULT_TOKEN
VAULT_MOUNT=secret
# AWS KMS (if SECRETS_BACKEND=aws_kms)
KMS_KEY_ARN=REPLACE_IF_USING_KMS

# ─────────────────────────────────────────────
# ELASTICSEARCH / SIEM
# ─────────────────────────────────────────────
ELASTICSEARCH_HOST=elasticsearch:9200
ELASTICSEARCH_INDEX_PREFIX=securevault
ELASTICSEARCH_USERNAME=securevault_logger
ELASTICSEARCH_PASSWORD=REPLACE_WITH_ES_PASSWORD

# ─────────────────────────────────────────────
# RATE LIMITING
# ─────────────────────────────────────────────
RATE_LIMIT_LOGIN=5/minute                    # per IP
RATE_LIMIT_API=100/minute                    # per user
RATE_LIMIT_UPLOAD=10/minute                  # per user
RATE_LIMIT_DOWNLOAD=50/minute                # per user

# ─────────────────────────────────────────────
# CORS / CSP
# ─────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://localhost:3000
CSRF_TRUSTED_ORIGINS=https://localhost:3000
# CSP is set in nginx.conf and Django middleware

# ─────────────────────────────────────────────
# ACCOUNT LOCKOUT
# ─────────────────────────────────────────────
ACCOUNT_LOCKOUT_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION=900                 # seconds (15 minutes)
ACCOUNT_LOCKOUT_BACKOFF=exponential          # linear | exponential

# ─────────────────────────────────────────────
# CELERY (ASYNC TASK QUEUE)
# ─────────────────────────────────────────────
CELERY_BROKER_URL=redis://:REPLACE_WITH_REDIS_PASSWORD@redis:6379/1
CELERY_RESULT_BACKEND=redis://:REPLACE_WITH_REDIS_PASSWORD@redis:6379/2

# ─────────────────────────────────────────────
# MONITORING
# ─────────────────────────────────────────────
SENTRY_DSN=REPLACE_WITH_SENTRY_DSN           # optional
METRICS_ENABLED=True
METRICS_PORT=9090

# ─────────────────────────────────────────────
# TLS
# ─────────────────────────────────────────────
TLS_CERT_PATH=/run/secrets/tls_cert
TLS_KEY_PATH=/run/secrets/tls_key
TLS_CA_PATH=/run/secrets/tls_ca
